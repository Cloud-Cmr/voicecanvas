{
  "name": "voicecanvas",
  "version": "0.7.0",
  "description": "??? VoiceCanvas ???????AI ?????????????????? MiMo TTS",
  "private": true,
  "main": "./out/main/index.js",
  "author": "VoiceCanvas contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:win": "electron-vite build && electron-builder --win",
    "build:mobile": "vite build --config vite.mobile.config.ts && node scripts/finalize-mobile.mjs",
    "apk": "npm run build:mobile && node scripts/prepare-apk.mjs && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.9.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "com.voicecanvas.app",
    "productName": "VoiceCanvas",
    "copyright": "Copyright ? 2026 VoiceCanvas contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "??? VoiceCanvas",
      "artifactName": "VoiceCanvas-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "VoiceCanvas-${version}-Portable.${ext}"
    }
  }
}
